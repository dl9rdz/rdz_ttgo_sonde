livemap.html 1275
<!DOCTYPE html>
<html>
<head>
  <title>rdzTTGOSonde Server LiveMap</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <link rel="stylesheet" type="text/css" href="style.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css" />
  <script>
    var mapcenter=[48,13];
    // HTTPS helper that may call geolocation. Must not be the ESP32 itself.
    var phoneGpsUrl='https://rdzsonde.org/locate';
  </script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet.marker.slideto@0.2.0/Leaflet.Marker.SlideTo.js"></script>
</head>
<body>
  <div id="map"></div>
  <script>
    fetch('/status.json')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.meta && Array.isArray(d.meta.mapCenter) && d.meta.mapCenter.length >= 2) {
          mapcenter = d.meta.mapCenter;
        }
      })
      .catch(function () {})
      .finally(function () {
        var s = document.createElement('script');
        s.src = 'livemap.js';
        document.body.appendChild(s);
      });
  </script>
</body>
</html>
index.html 2021
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <title>rdzTTGOSonde</title>
  <link rel="icon" href="data:,">
  <script defer src="./app.4ca9d2a5.js"></script>
  <link rel="stylesheet" href="./app.1f88533f.css">
</head>
<body>
  <div id="app" class="app">
    <nav class="nav" id="nav">
      <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Menu">☰</button>
      <div class="nav-items">
        <button type="button" class="nav-item active" data-panel="home">Home</button>
        <button type="button" class="nav-item" data-panel="decoder">Decoder</button>
        <button type="button" class="nav-item" data-panel="map">Map</button>
        <button type="button" class="nav-item" data-panel="control">Control</button>
        <button type="button" class="nav-item" data-panel="qrg">QRG</button>
        <button type="button" class="nav-item" data-panel="wifi">WiFi</button>
        <button type="button" class="nav-item" data-panel="config">Config</button>
      </div>
    </nav>

    <main class="main">
      <section id="panel-home" class="panel active"></section>
      <section id="panel-decoder" class="panel" hidden></section>
      <section id="panel-map" class="panel panel-fill" hidden>
        <iframe class="fill-frame" title="Live map" src=""></iframe>
      </section>
      <section id="panel-control" class="panel" hidden></section>
      <section id="panel-qrg" class="panel" hidden></section>
      <section id="panel-wifi" class="panel" hidden></section>
      <section id="panel-config" class="panel panel-fill" hidden>
        <iframe class="fill-frame" title="Config" src=""></iframe>
      </section>
    </main>

    <footer class="statusbar" id="statusbar">
      <div class="statusbar-left" id="bar-left"></div>
      <div class="statusbar-right" id="bar-right"></div>
    </footer>
  </div>
</body>
</html>
style.css 8440
body, html {
	height: 100%;
	margin: 0;
	font-family: Arial;
}

.system-info {
	padding: 20px;
	font-family: Arial, sans-serif;
	flex-grow: 1;
	overflow-y: auto;
}
.system-info p { margin: 8px 0; }
.system-info h1 { font-size: 24px; margin-bottom: 10px; }

.status-table {
	width: 100%;
	border-collapse: collapse;
	margin-top: 20px;
}
.status-table th, .status-table td {
	padding: 10px;
	border: 1px solid #ccc;
	text-align: left;
	vertical-align: top;
}
.status-table th { background-color: #f4f4f4; font-weight: bold; }
#refresh-button { background: none; border: none; cursor: pointer; }
#refresh-button:hover { color: #007BFF; }

h2.external-links {
	margin-top: 40px;
	text-align: center;
	font-size: 20px;
	margin-bottom: 15px;
}
.link-buttons {
	display: flex;
	justify-content: center;
	gap: 20px;
}
.link-buttons .button {
	background-color: #04AA6D;
	color: white;
	padding: 15px 20px;
	text-decoration: none;
	border-radius: 5px;
	font-size: 18px;
	transition: background-color 0.3s ease;
}

.active, .cfgheader:hover { background-color: #ccc; }
.cfgpanel:hover td, .cfgpanel:active td {
	background-color: #808080 !important;
	color: white;
}
th.cfg { padding: 5pt; }

.hamburger {
	position: relative;
	display: inline-block;
	width: 1.25em;
	height: 0.8em;
	margin-right: 0.3em;
	border-top: 0.2em solid #fff;
	border-bottom: 0.2em solid #fff;
}
.hamburger:before {
	content: "";
	position: absolute;
	top: 0.3em;
	left: 0;
	width: 100%;
	border-top: 0.2em solid #fff;
}

.wrapper {
	height: 100%;
	display: flex;
	flex-direction: column;
	margin: 0;
}
.tci { flex-grow: 1; border: none; margin: 0; padding: 0; overflow-y: auto; }
.footer {
	background-color: #333;
	display: flex;
	justify-content: space-between;
}

td.ch { text-align: right; padding: 0 8px; }
td.act { text-align: center; }
table, th, td {
	border: 1px solid black;
	border-collapse: collapse;
	background-color: #ddd;
}
.content {
	display: flex;
	flex: 1;
	flex-direction: column;
	overflow: auto;
	height: 100%;
}
.tabcontent {
	display: none;
	flex: 1;
	border-top: none;
	flex-direction: column;
	overflow: auto;
}

html {
	font-family: Helvetica;
	display: inline-block;
	margin: 0 auto;
	text-align: left;
}
h1 { color: #0F3376; font-size: 24px; }

:disabled.save { opacity: 0.5; }
.save {
	background-color: #CC1111;
	border: white;
	border-width: 1;
	color: white;
	padding: 8px 30px;
	text-align: center;
	text-decoration: none;
	display: block;
	font-size: 14px;
	margin: 0;
}
.ttgoinfo {
	color: white;
	padding: 8px 10px;
	display: block;
	font-size: 14px;
	margin: 0;
}
.ctlbtn {
	background-color: #ccc;
	border: black;
	border-width: 1;
	color: black;
	padding: 4px 30px;
	text-align: center;
	text-decoration: none;
	display: block;
	font-size: 4vh;
	margin: 0.3em 0.3em 0;
}

#map { height: 100%; }

.leaflet-popup-content table, .leaflet-popup-content table td {
	border: 0;
	background-color: white;
}
.leaflet-popup-content table td:nth-child(2),
.leaflet-popup-content table td:nth-child(5) {
	text-align: right;
	padding-left: 3px;
}
.leaflet-popup-content table td:nth-child(3),
.leaflet-popup-content table td:nth-child(6) {
	text-align: left;
	padding-right: 10px;
}

.leaflet-gps { animation: fading 1s infinite; margin-left: -7px !important; margin-top: -9px !important; }
.leaflet-gps::after { content: '🔵'; }
@keyframes fading { 0% { opacity: 0.7; } 50% { opacity: 1; } 100% { opacity: 0.7; } }

.leaflet-burst { margin-left: -20px !important; margin-top: -22px !important; font-weight: bold; font-size: 30px; }
.leaflet-burst::after { content: '💥'; }
.leaflet-landing { margin-left: -13px !important; margin-top: -30px !important; font-weight: bold; font-size: 40px; }
.leaflet-landing::after { content: '×'; }

.leaflet-header {
	text-align: center;
	width: 250px;
	box-shadow: 0 1px 5px rgba(0,0,0,0.65);
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
	pointer-events: auto !important;
}
.leaflet-header #settings, .leaflet-header #sonde_detail { display: none; }
.leaflet-header label { display: block; margin-top: 5px; }
.leaflet-header input { width: 80px; margin: 0 auto; }
.leaflet-header #submit { margin: 3px auto; }

.leaflet-footer {
	display: none;
	text-align: center;
	width: 180px;
	box-shadow: 0 1px 5px rgba(0,0,0,0.65);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
}
.leaflet-center {
	left: 0;
	right: 0;
	margin: 0 auto;
	padding: 5px;
	background: rgba(255,255,255,0.8);
}

@media screen and (max-width: 600px) {
	.leaflet-control-attribution {
		transform: rotate(-90deg) translateX(100%);
		transform-origin: 100% 100%;
		-webkit-transform: rotate(-90deg) translateX(100%);
		-webkit-transform-origin: 100% 100%;
	}
	.topnav a:not(.active) { display: none; }
	.topnav a.icon { float: right; display: block; }
	.topnav.responsive { position: relative; }
	.topnav.responsive a.icon { position: absolute; right: 0; top: 0; }
	.topnav.responsive a { float: none; display: block; text-align: left; }
}

.ldot {
	height: 15px;
	width: 15px;
	margin-top: 8px;
	margin-left: -1px;
	border-radius: 50%;
	display: inline-block;
}
.ybg {
	background-color: orange;
	background-image: linear-gradient(top, yellow, orange);
}
.gbg {
	background-color: green;
	background-image: linear-gradient(top, lime, green);
}
.rbg {
	background-color: red;
	background-image: linear-gradient(top, orange, red);
}
#sonde_statbar .ldot { margin-right: 3px; }

/* topnav */
.topnav { background-color: #333; overflow: hidden; }
.topnav a {
	float: left;
	display: block;
	color: #f2f2f2;
	text-align: center;
	padding: 14px 16px;
	text-decoration: none;
	font-size: 17px;
}
.topnav a:hover { background-color: #ddd; color: black; }
.topnav a.active { background-color: #04AA6D; color: white; }
.topnav .icon { display: none; padding: 11px 16px 12px; }

@media (prefers-color-scheme: dark) {
	body { background-color: #333; }
	h1 { color: #3378f6; }
	h2 { color: white; }
	.system-info p { color: #bdbdbd; }
	.status-table th { color: black; }
	table, th, td, .save, a.active {
		color: white;
		border: 1px solid grey;
		border-collapse: collapse;
		background-color: #333;
	}
	input, select, .tci { color: white; background-color: #333; }
	a:link, a:visited { color: #D3D3D3; }
	.topnav { background-color: grey; }
	.topnav a:visited { color: white; }
	.ctlbtn, .leaflet-center { color: white; background-color: grey; }
	.leaflet-bar a { background-color: grey !important; }
	.leaflet-popup-content-wrapper, .leaflet-popup-tip {
		color: white !important;
		background: grey !important;
	}
}

/* decoder */
.decoder-page { padding: 8px; gap: 8px; }
.spectrum {
	background: #222;
	border: 1px solid #999;
	border-radius: 4px;
	padding: 4px;
}
.spectrum canvas { width: 100%; height: 240px; display: block; }
.spectrum-label { color: #ccc; font-size: 0.85em; padding: 4px 2px 0; }
.decoder-status, .decoder-card {
	background: #ddd;
	border: 1px solid #999;
	border-radius: 4px;
}
.decoder-status { padding: 10px 12px; font-weight: bold; }
.decoder-status.state-disabled { background: #ccc; }
.decoder-status.state-spectrum { background: #cde; }
.decoder-status.state-scan { background: #fec; }
.decoder-status.state-decode { background: #cfc; }
.decoder-list { display: flex; flex-direction: column; gap: 8px; }
.decoder-card {
	display: flex;
	flex-direction: column;
	gap: 2px;
	padding: 8px 10px;
}
.decoder-card.current { border-color: #04AA6D; box-shadow: inset 3px 0 0 #04AA6D; }
.decoder-card.empty { opacity: 0.75; font-style: italic; }
.decoder-card-head {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
	align-items: baseline;
	background: #ccc;
	margin: -8px -10px 4px;
	padding: 6px 10px;
}
.decoder-ch, .decoder-id { font-weight: bold; }
.decoder-ch { min-width: 3.5em; }
.decoder-type { min-width: 5em; }
.decoder-age { margin-left: auto; color: #555; font-size: 0.9em; }
.decoder-res { font-size: 0.85em; padding: 1px 6px; border-radius: 3px; background: #eee; }
.decoder-res.res-ok { background: #9d9; }
.decoder-res.res-err { background: #e99; }
.decoder-res.res-nopos { background: #ee9; }
.decoder-res.res-stale, .decoder-res.res-timeout { background: #ccc; color: #555; }
.decoder-card-id { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
.decoder-stats { font-weight: normal; font-size: 0.95em; }
.decoder-card-qth, .decoder-card-meteo, .decoder-card-kt, .decoder-card-links { font-size: 0.95em; }
.decoder-card-links a { margin-right: 0.2em; }
