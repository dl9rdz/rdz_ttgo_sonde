edit.html 3628
<!DOCTYPE html>
<!-- IDF httpd editor: fetch GET /file/<name>, save PUT /file/<name>  -->
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Edit</title>
  <script>
  (function () {
    var mode = localStorage.getItem('rdz-theme') || 'auto';
    if (mode === 'light' || mode === 'dark') {
      document.documentElement.setAttribute('data-theme', mode);
    }
  })();
  </script>
  <link rel="stylesheet" href="./app.css">
  <style>
    html, body { height: auto; overflow: auto; }
    body { margin: 1rem; }
    textarea {
      width: 100%; min-height: 24rem;
      font-family: ui-monospace, monospace; font-size: .85rem;
      background: var(--bg-elev); color: var(--text); border: 1px solid var(--border);
      border-radius: var(--radius);
    }
  </style>
</head>
<body>
  <h1 id="title">Edit</h1>
  <p id="status" class="muted">Loading…</p>
  <textarea id="editor" cols="80" rows="40" spellcheck="false" disabled></textarea>
  <p>
    <button type="button" id="save" class="primary" disabled>Save</button>
  </p>

  <script>
  function basenameOk(name) {
    return name.length > 0 && name.length <= 64 && /^[A-Za-z0-9._-]+$/.test(name);
  }

  function setStatus(msg, cls) {
    const el = document.getElementById('status');
    el.textContent = msg;
    el.className = cls || 'muted';
  }

  function fileFromQuery() {
    const q = new URLSearchParams(location.search);
    return q.get('file') || '';
  }

  async function loadFile(name) {
    const res = await fetch('/file/' + encodeURIComponent(name), { credentials: 'same-origin' });
    if (res.status === 401) {
      location = '/login.html';
      return;
    }
    if (!res.ok) {
      throw new Error('HTTP ' + res.status + (res.statusText ? ' ' + res.statusText : ''));
    }
    return await res.text();
  }

  async function putFile(name, body) {
    const res = await fetch('/file/' + encodeURIComponent(name), {
      method: 'PUT',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'text/plain; charset=utf-8' },
      body: body
    });
    if (res.status === 401) {
      location = '/login.html';
      return false;
    }
    if (!res.ok) {
      throw new Error('HTTP ' + res.status + (res.statusText ? ' ' + res.statusText : ''));
    }
    return true;
  }

  async function init() {
    const name = fileFromQuery();
    const title = document.getElementById('title');
    const editor = document.getElementById('editor');
    const saveBtn = document.getElementById('save');

    if (!basenameOk(name)) {
      title.textContent = 'Edit';
      setStatus('Missing or invalid ?file= (basename only: A–Z a–z 0–9 . _ -)', 'err');
      return;
    }

    title.textContent = 'Edit: ' + name;
    document.title = 'Edit ' + name;

    try {
      const text = await loadFile(name);
      if (text === undefined) return;
      editor.value = text;
      editor.disabled = false;
      saveBtn.disabled = false;
      setStatus('Loaded ' + name + ' (' + text.length + ' bytes)', 'ok');
    } catch (e) {
      setStatus('Load failed: ' + e.message, 'err');
      return;
    }

    saveBtn.addEventListener('click', async () => {
      saveBtn.disabled = true;
      setStatus('Saving…', 'muted');
      try {
        const ok = await putFile(name, editor.value);
        if (ok) setStatus('Saved ' + name, 'ok');
      } catch (e) {
        setStatus('Save failed: ' + e.message, 'err');
      } finally {
        saveBtn.disabled = false;
      }
    });
  }

  init();
  </script>
</body>
</html>
sdfiles.html 9356
<!DOCTYPE html>
<html lang="en">
<head>
  <title>rdzTTGOSonde SD card</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="data:,">
  <script>
  (function () {
    var mode = localStorage.getItem('rdz-theme') || 'auto';
    if (mode === 'light' || mode === 'dark') {
      document.documentElement.setAttribute('data-theme', mode);
    }
  })();
  </script>
  <!-- href rewritten to hashed app.*.css by web/scripts/copy-to-data.mjs -->
  <link rel="stylesheet" href="./app.1f88533f.css">
</head>
<body>
  <div class="app">
    <nav class="nav">
      <a class="nav-item" href="/">← Home</a>
      <span class="nav-item active">SD card</span>
    </nav>
    <main class="main">
      <div class="panel">
        <div class="card">
          <div class="card-title" id="sd-heading">SD card: /</div>
          <div class="table-wrap">
            <table class="status-table compact" id="fileTable">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Size</th>
                  <th>Timestamp</th>
                  <th class="actions">Actions</th>
                </tr>
              </thead>
              <tbody id="fileBody">
                <tr><td colspan="4" class="muted">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
    <footer class="statusbar">
      <div class="statusbar-left"></div>
      <div class="statusbar-right" id="sd-foot">rdzTTGOsonde</div>
    </footer>
  </div>

  <div class="modal" id="viewModal">
    <div class="modal-dialog">
      <div class="modal-head">
        <h2 id="viewModalTitle">File</h2>
        <button type="button" id="viewModalClose" class="modal-close" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body" id="viewModalTable"></div>
    </div>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const dir = params.get('dir') || '';
    const pdir = dir ? dir + '/' : '';
    const internal = dir === '.int' || dir.startsWith('.int/');

    function internalFileParam(fileName) {
      const full = pdir + fileName;
      return full.startsWith('.int/') ? full.slice('.int/'.length) : fileName;
    }

    function parentDir(d) {
      if (!d) return '';
      const i = d.lastIndexOf('/');
      return i < 0 ? '' : d.slice(0, i);
    }

    function formatSize(n) {
      if (n === undefined || n === null || n === '') return '';
      const v = Number(n);
      if (!Number.isFinite(v)) return String(n);
      if (v < 1024) return v + ' B';
      if (v < 1024 * 1024) return (v / 1024).toFixed(1) + ' KB';
      return (v / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function parseCsv(text) {
      const lines = text.split(/\r?\n/).filter(function (l) { return l.length > 0; });
      return lines.map(function (line) {
        const row = [];
        let cell = '', inQuotes = false;
        for (let i = 0; i < line.length; i++) {
          const c = line[i];
          if (c === '"') { inQuotes = !inQuotes; continue; }
          if (!inQuotes && c === ',') { row.push(cell.trim()); cell = ''; continue; }
          cell += c;
        }
        row.push(cell.trim());
        return row;
      });
    }

    function viewCsv(path, title) {
      const modal = document.getElementById('viewModal');
      const titleEl = document.getElementById('viewModalTitle');
      const tableEl = document.getElementById('viewModalTable');
      titleEl.textContent = title;
      tableEl.innerHTML = '<p class="muted">Loading…</p>';
      tableEl.scrollTop = 0;
      modal.classList.add('show');
      fetch('/sd/' + path)
        .then(function (r) { return r.text(); })
        .then(function (text) {
          const rows = parseCsv(text);
          if (!rows.length) {
            tableEl.innerHTML = '<p class="muted">Empty file.</p>';
            return;
          }
          let html = '<div class="table-wrap"><table class="status-table"><tbody>';
          rows.forEach(function (row) {
            html += '<tr>';
            row.forEach(function (cell) {
              html += '<td>' + escapeHtml(cell) + '</td>';
            });
            html += '</tr>';
          });
          html += '</tbody></table></div>';
          tableEl.innerHTML = html;
        })
        .catch(function (err) {
          tableEl.innerHTML = '<p class="err">Error loading file: ' + escapeHtml(err.message) + '</p>';
        });
    }

    function sortEntries(entries) {
      return entries.slice().sort(function (a, b) {
        if ((a.dir === 1) !== (b.dir === 1)) return a.dir === 1 ? -1 : 1;
        const tA = new Date(a.ts || 0).getTime();
        const tB = new Date(b.ts || 0).getTime();
        return tB - tA;
      });
    }

    function renderRow(tableBody, file) {
      const row = document.createElement('tr');
      const nameCell = document.createElement('td');
      const sizeCell = document.createElement('td');
      const tsCell = document.createElement('td');
      const actionCell = document.createElement('td');
      actionCell.className = 'actions';

      const link = document.createElement('a');
      if (file.dir === 1) {
        link.href = 'sdfiles.html?dir=' + encodeURIComponent(pdir + file.name);
        link.textContent = file.name + '/';
      } else {
        link.href = '/sd/' + pdir + file.name;
        link.textContent = file.name;
      }
      nameCell.appendChild(link);
      sizeCell.textContent = file.dir === 1 ? '—' : formatSize(file.size);
      tsCell.textContent = file.ts || '';

      if (file.dir !== 1) {
        if (!internal) {
          const viewBtn = document.createElement('button');
          viewBtn.type = 'button';
          viewBtn.className = 'btn-sm';
          viewBtn.textContent = 'View';
          viewBtn.onclick = function () { viewCsv(pdir + file.name, file.name); };
          actionCell.appendChild(viewBtn);
        }

        if (internal) {
          const editBtn = document.createElement('button');
          editBtn.type = 'button';
          editBtn.className = 'btn-sm';
          editBtn.textContent = 'Edit';
          const editName = internalFileParam(file.name);
          editBtn.onclick = function () {
            location.href = 'edit.html?file=' + encodeURIComponent(editName);
          };
          actionCell.appendChild(editBtn);
        }
      }

      if (!internal) {
        const deleteBtn = document.createElement('button');
        deleteBtn.type = 'button';
        deleteBtn.className = 'btn-sm danger';
        deleteBtn.textContent = 'Delete';
        deleteBtn.onclick = function () {
          if (!confirm('Delete "' + file.name + '"?')) return;
          fetch('sdrm.html?file=' + encodeURIComponent(pdir + file.name))
            .then(function (resp) {
              if (resp.ok) row.remove();
              else alert('Delete failed.');
            })
            .catch(function () { alert('Error sending request.'); });
        };
        actionCell.appendChild(deleteBtn);
      }

      row.append(nameCell, sizeCell, tsCell, actionCell);
      tableBody.appendChild(row);
    }

    document.getElementById('viewModalClose').onclick = function () {
      document.getElementById('viewModal').classList.remove('show');
    };
    document.getElementById('viewModal').onclick = function (e) {
      if (e.target.id === 'viewModal') e.target.classList.remove('show');
    };

    document.getElementById('sd-heading').textContent = 'SD card: /' + (dir || '');

    fetch('/meta.json', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (meta) {
        var id = meta.versionId || '';
        document.getElementById('sd-foot').textContent = id ? ('rdzTTGOsonde ' + id) : 'rdzTTGOsonde';
      })
      .catch(function () {});

    const body = document.getElementById('fileBody');
    const url = '/files.json' + (dir ? '?dir=' + encodeURIComponent(dir) : '');
    fetch(url)
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (data) {
        body.innerHTML = '';
        if (dir) {
          const up = document.createElement('tr');
          up.innerHTML =
            '<td colspan="4"><a href="sdfiles.html' +
            (parentDir(dir) ? '?dir=' + encodeURIComponent(parentDir(dir)) : '') +
            '">.. parent directory</a></td>';
          body.appendChild(up);
        }
        const entries = Array.isArray(data) ? sortEntries(data) : [];
        if (!entries.length) {
          const empty = document.createElement('tr');
          empty.innerHTML = '<td colspan="4" class="muted">No files</td>';
          body.appendChild(empty);
          return;
        }
        entries.forEach(function (file) { renderRow(body, file); });
      })
      .catch(function (err) {
        body.innerHTML = '<tr><td colspan="4" class="err">' + escapeHtml(err.message) + '</td></tr>';
      });
  </script>
</body>
</html>
login.html 4102
<!DOCTYPE html>
<html lang="en">
<head>
  <title>rdzTTGOSonde Login</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="data:,">
  <script>
  (function () {
    var mode = localStorage.getItem('rdz-theme') || 'auto';
    if (mode === 'light' || mode === 'dark') {
      document.documentElement.setAttribute('data-theme', mode);
    }
  })();
  </script>
  <script src="sha256.min.js"></script>
  <!-- href rewritten to hashed app.*.css by web/scripts/copy-to-data.mjs to force reload after changes -->
  <link rel="stylesheet" href="./app.1f88533f.css">
</head>
<body>
  <div class="app">
    <nav class="nav">
      <span class="nav-item active">Login</span>
    </nav>
    <main class="main">
      <div class="panel panel-narrow">
        <div class="card">
          <h1>Login</h1>
          <form id="loginForm" action="/login.html" method="POST" onsubmit="computeHash(event)">
            <div class="field">
              <label for="user">Username</label>
              <input type="text" id="user" name="user" required autocomplete="username">
            </div>
            <div class="field">
              <label for="pass">Password</label>
              <input type="password" id="pass" name="pass" required autocomplete="current-password">
            </div>
            <input type="hidden" id="preauth" name="preauth" value="">
            <button type="submit" class="primary btn-block">Login</button>
            <p id="login-status" class="err" hidden></p>
          </form>
        </div>
      </div>
    </main>
    <footer class="statusbar">
      <div class="statusbar-left"></div>
      <div class="statusbar-right" id="login-foot">rdzTTGOsonde</div>
    </footer>
  </div>
  <script>
    function setLoginStatus(text) {
      var el = document.getElementById('login-status');
      el.textContent = text || '';
      el.hidden = !text;
    }
    async function computeHash(event) {
      event.preventDefault();
      setLoginStatus('');
      var username = document.getElementById('user').value;
      var password = document.getElementById('pass').value;
      var preauth = document.getElementById('preauth').value;
      if (!preauth) {
        setLoginStatus('The device was not reached.');
        return;
      }
      document.getElementById('pass').value = '';
      var auth = sha256(username + ':' + preauth + ':' + password);
      var btn = event.target.querySelector('button[type="submit"]');
      btn.disabled = true;
      try {
        var r = await fetch('/login.html', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ user: username, preauth: preauth, auth: auth })
        });
        if (r.ok) {
          location.href = '/index.html';
          return;
        }
        var msg = (await r.text()).trim();
        setLoginStatus(msg || ('HTTP ' + r.status));
      } catch (e) {
        setLoginStatus('The device was not reached.');
      } finally {
        btn.disabled = false;
      }
    }
    async function initLogin() {
      try {
        var preRes = await fetch('/preauth', { credentials: 'same-origin' });
        if (!preRes.ok) throw new Error('preauth');
        var pre = await preRes.json();
        if (!pre.preauth) throw new Error('preauth');
        document.getElementById('preauth').value = pre.preauth;
      } catch (e) {
        setLoginStatus('The device was not reached.');
      }
      try {
        var metaRes = await fetch('/meta.json', { credentials: 'same-origin' });
        if (!metaRes.ok) return;
        var meta = await metaRes.json();
        var id = meta.versionId || '';
        document.getElementById('login-foot').textContent = id ? ('rdzTTGOsonde ' + id) : 'rdzTTGOsonde';
      } catch (e) { /* version line is optional */ }
    }
    document.addEventListener('DOMContentLoaded', initLogin);
  </script>
</body>
</html>
